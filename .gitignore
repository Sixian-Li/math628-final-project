# Python environment and caches
.venv/
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Stock panel, SMA and feature caches (about 460 MB); rebuilt automatically on first run
data/processed/*.pkl
data/processed/*.tmp

# LaTeX build products; the compiled report is kept as reports/final_report.pdf
reports/latex/main.pdf
reports/latex/*.aux
reports/latex/*.fdb_latexmk
reports/latex/*.fls
reports/latex/*.log
reports/latex/*.out
reports/latex/*.synctex.gz

# The scripts write more into results/ than the report uses (per-run CSVs, equity curves, extra charts).
# Only the files below are kept in the repository; everything else is regenerated by the commands in README.md.
results/**
!results/**/
# first design: the proposal's five cases and their longer history (Appendix A)
!results/summary.md
!results/robustness/summary_robustness.md
# first design on SMA20/140 (Table 2)
!results/cases/QQQ_SMA20_140/metrics.csv
!results/cases/QQQ_SMA20_140/prediction_metrics.csv
!results/cases/QQQ_SMA20_140/summary.md
!results/cases/QQQ_SMA20_140/robustness/wf_metrics.csv
!results/cases/QQQ_SMA20_140/robustness/summary_robustness.md
# other attempts on the first design (Appendix A)
!results/ml_only/summary.md
!results/meta_label/sma20_140/summary.md
!results/meta_label/grid/summary.txt
!results/stocks/sma*/summary.md
# pre-screen on data through 2018 (Table 3)
!results/prescreen_dev.txt
# Ridge filter on QQQ (Tables 7 and 8, the checks of Section 7.1, the reverse-time test)
!results/qqq_state/QQQ_sma20_140/grid.csv
!results/qqq_state/QQQ_sma20_140/summary.md
!results/qqq_state/QQQ_sma20_140/diagnostics.md
!results/qqq_state/reverse/summary.md
# machine-learning rankings of stocks (Section 6.4)
!results/stock_rank/sma20_140/summary.md
# ablation (Tables 6, 10 and 11)
!results/ablation/grid.csv
!results/ablation/summary.md
# 222 moving-average pairs (Table 12, Figures 6 and A3)
!results/ablation/sma_grid/summary.csv
!results/ablation/sma_grid/gain_vs_sma.csv
!results/ablation/sma_grid/summary.md
!results/ablation/sma_grid/heat_cagr_top10.png
# leave-one-period-out test (Tables 13 to 15, Figures 7, A1 and A2)
!results/ablation/blocks/headline_top10.csv
!results/ablation/blocks/summary.csv
!results/ablation/blocks/versus.csv
!results/ablation/blocks/summary.md
!results/ablation/blocks/heat_cagr_top10.png
!results/ablation/blocks/heat_hold_cagr_top10.png
!results/ablation/blocks/heat_sharpe_top10.png
